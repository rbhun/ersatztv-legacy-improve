+++ b/crates/ersatztv-channel/src/progress.rs
@@ -0,0 +1,143 @@
+use std::borrow::Cow;
+use std::path::PathBuf;
+
+use time::OffsetDateTime;
+use tokio::io::{AsyncBufReadExt, AsyncRead};
+use tokio::task::JoinHandle;
+use tracing::Instrument;
+
+use crate::playlist_manager::write_atomic;
+
+pub const PROGRESS_FILE_NAME: &str = "ffmpeg-progress.txt";
+
+pub const PROGRESS_ARGS: [&str; 2] = ["-progress", "pipe:1"];
+
+pub struct ProgressHeader<'a> {
+    pub item_id: &'a str,
+    pub pid: Option<u32>,
+    pub realtime: bool,
+    /// wall clock time of the first output frame
+    pub output_start: OffsetDateTime,
+    pub args: &'a [Cow<'a, str>],
+}
+
+/// Publishes each `-progress` report, prefixed with what the report belongs to, so the host
+/// can show live transcode statistics without parsing ffmpeg's log.
+pub fn spawn_progress_writer(
+    stdout: impl AsyncRead + Unpin + Send + 'static,
+    output_folder: PathBuf,
+    header: ProgressHeader<'_>,
+) -> JoinHandle<()> {
+    let header = header.render(OffsetDateTime::now_utc());
+    let dest = output_folder.join(PROGRESS_FILE_NAME);
+
+    tokio::spawn(
+        async move {
+            let mut lines = tokio::io::BufReader::new(stdout).lines();
+            let mut block = String::new();
+            let mut seq: u64 = 0;
+            while let Ok(Some(line)) = lines.next_line().await {
+                block.push_str(&line);
+                block.push('\n');
+                if line.starts_with("progress=") {
+                    seq += 1;
+                    let body = format!("{header}seq={seq}\n{block}");
+                    if let Err(e) = write_atomic(&output_folder, &dest, body).await {
+                        log::debug!("failed to write ffmpeg progress: {e}");
+                    }
+                    block.clear();
+                }
+            }
+        }
+        .in_current_span(),
+    )
+}
+
+impl ProgressHeader<'_> {
+    fn render(&self, started_at: OffsetDateTime) -> String {
+        let args = self
+            .args
+            .iter()
+            .map(|a| quote(a))
+            .collect::<Vec<_>>()
+            .join(" ");
+        format!(
+            "item_id={}\npid={}\nstarted_at={}\noutput_start={}\nrealtime={}\nargs={args}\n",
+            self.item_id.replace(['\n', '\r'], " "),
+            self.pid.map(|p| p.to_string()).unwrap_or_default(),
+            unix_ms(started_at),
+            unix_ms(self.output_start),
+            self.realtime,
+        )
+    }
+}
+
+fn unix_ms(time: OffsetDateTime) -> i128 {
+    time.unix_timestamp_nanos() / 1_000_000
+}
+
+fn quote(arg: &str) -> Cow<'_, str> {
+    if !arg.is_empty() && !arg.contains(|c: char| c.is_whitespace() || c == '"') {
+        return Cow::Borrowed(arg);
+    }
+
+    let escaped = arg.replace(['\n', '\r'], " ").replace('"', "\\\"");
+    Cow::Owned(format!("\"{escaped}\""))
+}
+
+#[cfg(test)]
+mod tests {
+    use time::macros::datetime;
+
+    use super::*;
+
+    #[test]
+    fn header_quotes_arguments_with_spaces() {
+        let args = [
+            Cow::Borrowed("-i"),
+            Cow::Borrowed("/media/My Movie.mkv"),
+            Cow::Borrowed("-vf"),
+            Cow::Borrowed("drawtext=text=\"hi\""),
+        ];
+        let header = ProgressHeader {
+            item_id: "42",
+            pid: Some(7),
+            realtime: true,
+            output_start: datetime!(2026-01-01 00:00:01 UTC),
+            args: &args,
+        };
+
+        let rendered = header.render(datetime!(2026-01-01 00:00:00 UTC));
+
+        assert_eq!(
+            rendered,
+            "item_id=42\npid=7\nstarted_at=1767225600000\noutput_start=1767225601000\nrealtime=true\n\
+             args=-i \"/media/My Movie.mkv\" -vf \"drawtext=text=\\\"hi\\\"\"\n"
+        );
+    }
+
+    #[tokio::test]
+    async fn writes_each_report_with_header() {
+        let folder = tempfile::tempdir().unwrap();
+        let stdout: &[u8] = b"frame=10\nfps=25.0\nprogress=continue\nframe=20\nprogress=end\n";
+        let args = [Cow::Borrowed("-i"), Cow::Borrowed("in.mkv")];
+
+        spawn_progress_writer(
+            stdout,
+            folder.path().to_path_buf(),
+            ProgressHeader {
+                item_id: "1",
+                pid: None,
+                realtime: false,
+                output_start: OffsetDateTime::now_utc(),
+                args: &args,
+            },
+        )
+        .await
+        .unwrap();
+
+        let contents = std::fs::read_to_string(folder.path().join(PROGRESS_FILE_NAME)).unwrap();
+        assert!(contents.contains("\npid=\n"));
+        assert!(contents.ends_with("args=-i in.mkv\nseq=2\nframe=20\nprogress=end\n"));
+    }
+}
