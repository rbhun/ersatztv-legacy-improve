     private static string FrameRateText(string frameRate) =>
         FFmpegAccelerationInfo.ParseFrameRate(frameRate).Match(fps => fps.ToString("0.###", CultureInfo.CurrentCulture), () => frameRate);
 
+    private static string SourceResolution(Option<MediaItemInfo> maybeInfo) =>
+        maybeInfo.Filter(i => i.Width > 0 && i.Height > 0).Match(i => $"{i.Width}x{i.Height}", () => "-");
+
+    private static string SourceFrameRate(Option<MediaItemInfo> maybeInfo) =>
+        maybeInfo.Filter(i => !string.IsNullOrWhiteSpace(i.RFrameRate)).Match(i => $"{FrameRateText(i.RFrameRate)} fps", () => "-");
+
+    // without an explicit scale/pad or frame rate, ffmpeg keeps the source value
+    private static string OutputResolution(FFmpegAccelerationInfo accel, Option<MediaItemInfo> maybeInfo) =>
+        accel is { OutputWidth: { } width, OutputHeight: { } height } ? $"{width}x{height}" : SourceResolution(maybeInfo);
+
+    private static string OutputFrameRate(FFmpegAccelerationInfo accel, Option<MediaItemInfo> maybeInfo) =>
+        string.IsNullOrWhiteSpace(accel?.OutputFrameRate) ? SourceFrameRate(maybeInfo) : $"{FrameRateText(accel.OutputFrameRate)} fps";
+
+    private static string Bitrate(double? kbps) => kbps switch
+    {
+        null => "-",
+        >= 1000 => $"{kbps.Value / 1000:0.0} Mbps",
+        _ => $"{kbps.Value:0} kbps"
+    };
+
+    private static string TargetBitrate(string bitrate) =>
+        bitrate.EndsWith('k') && double.TryParse(bitrate[..^1], CultureInfo.InvariantCulture, out double kbps) ? Bitrate(kbps) : bitrate;
+
     private static string Speed(double? speed) => speed is { } s ? $"{s:0.00}x" : "-";
 
     private static string Percent(double? percent) => percent is { } p ? $"{p:0}%" : "-";
