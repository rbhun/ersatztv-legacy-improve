+    private FFmpegTranscodePerformance WithSegmentBitrate(
+        FFmpegTranscodePerformance performance,
+        DateTimeOffset writtenFrom,
+        DateTimeOffset? writtenUntil)
+    {
+        if (performance.Progress.BitrateKbps is not null)
+        {
+            return performance;
+        }
+
+        try
+        {
+            string playlist = fileSystem.File.ReadAllText(
+                fileSystem.Path.Combine(_workingDirectory, FFmpegPlaylistFileName));
+
+            (double? averageKbps, double? currentKbps) = HlsSegmentBitrate.Measure(
+                playlist,
+                segment =>
+                {
+                    IFileInfo info = fileSystem.FileInfo.New(fileSystem.Path.Combine(_workingDirectory, segment));
+                    return info.Exists ? (info.Length, new DateTimeOffset(info.LastWriteTimeUtc)) : null;
+                },
+                writtenFrom,
+                writtenUntil);
+
+            return performance with
+            {
+                Progress = performance.Progress with
+                {
+                    BitrateKbps = averageKbps,
+                    CurrentBitrateKbps = writtenUntil is null ? currentKbps : null
+                }
+            };
+        }
+        catch (Exception)
+        {
+            // playlist or segments replaced while reading
+            return performance;
+        }
+    }
+
