--- /dev/null
+++ b/ErsatzTV.Core/FFmpeg/HlsSegmentBitrate.cs
@@ -0,0 +1,55 @@
+using System.Globalization;
+
+namespace ErsatzTV.Core.FFmpeg;
+
+// ffmpeg reports no size for the hls muxer, so measure the segments it wrote instead
+public static class HlsSegmentBitrate
+{
+    private const int CurrentSegmentCount = 3;
+
+    public static (double? AverageKbps, double? CurrentKbps) Measure(
+        string playlist,
+        Func<string, (long Size, DateTimeOffset WrittenAt)?> statSegment,
+        DateTimeOffset writtenFrom,
+        DateTimeOffset? writtenUntil)
+    {
+        var segments = new List<(long Size, double Duration)>();
+        double? pendingDuration = null;
+
+        foreach (string rawLine in playlist.Split('\n'))
+        {
+            string line = rawLine.Trim();
+            if (line.StartsWith("#EXTINF:", StringComparison.Ordinal))
+            {
+                string value = line["#EXTINF:".Length..].Split(',')[0];
+                pendingDuration = double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out double d)
+                    ? d
+                    : null;
+                continue;
+            }
+
+            if (line.Length == 0 || line.StartsWith('#'))
+            {
+                continue;
+            }
+
+            if (pendingDuration is { } duration && duration > 0 &&
+                statSegment(line) is { } stat &&
+                stat.WrittenAt >= writtenFrom &&
+                (writtenUntil is null || stat.WrittenAt < writtenUntil))
+            {
+                segments.Add((stat.Size, duration));
+            }
+
+            pendingDuration = null;
+        }
+
+        return (Kbps(segments), Kbps(segments.TakeLast(CurrentSegmentCount).ToList()));
+    }
+
+    private static double? Kbps(List<(long Size, double Duration)> segments)
+    {
+        double seconds = segments.Sum(s => s.Duration);
+        return seconds > 0 ? segments.Sum(s => s.Size) * 8 / seconds / 1000 : null;
+    }
+}
