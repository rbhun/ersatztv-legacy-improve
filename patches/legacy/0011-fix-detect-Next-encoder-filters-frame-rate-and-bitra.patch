@@ -0,0 +1,65 @@
+using ErsatzTV.Core.FFmpeg;
+using NUnit.Framework;
+using Shouldly;
+
+namespace ErsatzTV.Core.Tests.FFmpeg;
+
+[TestFixture]
+public class HlsSegmentBitrateTests
+{
+    private const string Playlist =
+        "#EXTM3U\n" +
+        "#EXT-X-TARGETDURATION:4\n" +
+        "#EXTINF:4.000000,\n" +
+        "#EXT-X-PROGRAM-DATE-TIME:2026-11-22T18:00:00.000+0100\n" +
+        "live000001.ts\n" +
+        "#EXTINF:4.000000,\n" +
+        "live000002.ts\n" +
+        "#EXTINF:2.000000,\n" +
+        "live000003.ts\n" +
+        "#EXTINF:4.000000,\n" +
+        "live000004.ts\n" +
+        "#EXTINF:4.000000,\n" +
+        "live000005.ts\n";
+
+    private static readonly DateTimeOffset Start = new(2026, 11, 22, 17, 0, 0, TimeSpan.Zero);
+
+    // 1 MB per 4 seconds = 2,000 kbps; segment 1 belongs to the previous item, segment 5 is missing
+    private static (long Size, DateTimeOffset WrittenAt)? Stat(string segment) =>
+        segment switch
+        {
+            "live000001.ts" => (4_000_000, Start.AddSeconds(-1)),
+            "live000002.ts" => (1_000_000, Start.AddSeconds(1)),
+            "live000003.ts" => (500_000, Start.AddSeconds(2)),
+            "live000004.ts" => (2_000_000, Start.AddSeconds(3)),
+            _ => null
+        };
+
+    [Test]
+    public void Measures_Segments_Written_Since_Start()
+    {
+        (double? average, double? current) = HlsSegmentBitrate.Measure(Playlist, Stat, Start, null);
+
+        // 3.5 MB over 10 seconds
+        average.ShouldBe(2800);
+        current.ShouldBe(2800);
+    }
+
+    [Test]
+    public void Stops_At_Next_Item()
+    {
+        (double? average, _) = HlsSegmentBitrate.Measure(Playlist, Stat, Start, Start.AddSeconds(3));
+
+        // 1.5 MB over 6 seconds
+        average.ShouldBe(2000);
+    }
+
+    [Test]
+    public void No_Segments_Yet()
+    {
+        (double? average, double? current) = HlsSegmentBitrate.Measure(Playlist, Stat, Start.AddHours(1), null);
+
+        average.ShouldBeNull();
+        current.ShouldBeNull();
+    }
+}
