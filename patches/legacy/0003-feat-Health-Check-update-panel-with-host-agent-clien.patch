+    private async Task PollUpdates(CancellationToken cancellationToken)
+    {
+        try
+        {
+            await LoadSources(cancellationToken);
+            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
+            do
+            {
+                await RefreshUpdateState(cancellationToken);
+                await InvokeAsync(StateHasChanged);
+            } while (await timer.WaitForNextTickAsync(cancellationToken));
+        }
+        catch (OperationCanceledException)
+        {
+            // page disposed
+        }
+        catch (Exception ex)
+        {
+            _updateError = ex.Message;
+            _updateStatusText = "Agent error";
+            await InvokeAsync(StateHasChanged);
+        }
+    }
+
+    private async Task LoadSources(CancellationToken cancellationToken)
+    {
+        Either<BaseError, UpdateSourcesResponse> result = await UpdateAgentClient.GetSources(cancellationToken);
+        foreach (BaseError error in result.LeftToSeq())
+        {
+            _updateError = error.Value;
+            _updateStatusText = "Agent unavailable";
+        }
+
+        foreach (UpdateSourcesResponse response in result.RightToSeq())
+        {
+            _sources.Clear();
+            _sources.AddRange(response.Sources ?? []);
+            if (string.IsNullOrWhiteSpace(_selectedSourceId) && _sources.Count > 0)
+            {
+                _selectedSourceId = _sources[0].Id;
+            }
+        }
+    }
+
+    private async Task RefreshUpdateState(CancellationToken cancellationToken)
+    {
+        if (string.IsNullOrWhiteSpace(_selectedSourceId))
+        {
+            return;
+        }
+
+        Either<BaseError, UpdateStatusResponse> statusResult = await UpdateAgentClient.GetStatus(cancellationToken);
+        foreach (UpdateStatusResponse status in statusResult.RightToSeq())
+        {
+            _updating = status.Updating;
+            _installedVersion = status.InstalledVersion;
+            if (!string.IsNullOrWhiteSpace(status.LastError) && status.LastOk == false)
+            {
+                _updateError = status.LastError;
+            }
+        }
+
+        Either<BaseError, UpdateCheckResponse> checkResult =
+            await UpdateAgentClient.Check(_selectedSourceId, cancellationToken);
+        foreach (BaseError error in checkResult.LeftToSeq())
+        {
+            _updateError = error.Value;
+            _updateStatusText = _updating ? "Updating…" : "Check failed";
+        }
+
+        foreach (UpdateCheckResponse check in checkResult.RightToSeq())
+        {
+            _updateError = null;
+            _updateAvailable = check.UpdateAvailable;
+            _localSha = check.LocalSha;
+            _remoteSha = check.RemoteSha;
+            _installedVersion = check.InstalledVersion ?? _installedVersion;
+            _updateStatusText = _updating
+                ? "Updating…"
+                : _updateAvailable
+                    ? "Update available"
+                    : "Up to date";
+        }
+
+        Either<BaseError, string> logResult = await UpdateAgentClient.GetLog(cancellationToken);
+        foreach (string log in logResult.RightToSeq())
+        {
+            _updateLog = log ?? string.Empty;
+        }
+    }
+
+    private async Task OnSourceChanged(string sourceId)
+    {
+        _selectedSourceId = sourceId;
+        if (_updateCts is { IsCancellationRequested: false })
+        {
+            await RefreshUpdateState(_updateCts.Token);
+            await InvokeAsync(StateHasChanged);
+        }
+    }
+
+    private async Task StartUpdate()
+    {
+        if (!CanUpdate())
+        {
+            return;
+        }
+
+        _updating = true;
+        _updateStatusText = "Updating…";
+        _updateError = null;
+        Either<BaseError, UpdateStartResponse> result =
+            await UpdateAgentClient.StartUpdate(_selectedSourceId, CancellationToken.None);
+        foreach (BaseError error in result.LeftToSeq())
+        {
+            _updating = false;
+            _updateError = error.Value;
+            _updateStatusText = "Update failed to start";
+        }
+
+        Either<BaseError, string> logResult = await UpdateAgentClient.GetLog(CancellationToken.None);
+        foreach (string log in logResult.RightToSeq())
+        {
+            _updateLog = log ?? string.Empty;
+        }
+    }
+
+    private bool CanUpdate() =>
+        UpdateAgentClient.IsConfigured
+        && !_updating
+        && _updateAvailable
+        && !string.IsNullOrWhiteSpace(_selectedSourceId);
+
+    private Color UpdateChipColor()
+    {
+        if (_updating)
+        {
+            return Color.Info;
+        }
+
+        if (!string.IsNullOrWhiteSpace(_updateError))
+        {
+            return Color.Error;
+        }
+
+        return _updateAvailable ? Color.Warning : Color.Success;
+    }
+
