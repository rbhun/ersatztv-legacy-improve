@@ -0,0 +1,121 @@
+using ErsatzTV.Core.FFmpeg;
+using NUnit.Framework;
+using Shouldly;
+
+namespace ErsatzTV.Core.Tests.FFmpeg;
+
+[TestFixture]
+public class UnderrunDetectorTests
+{
+    private static readonly DateTimeOffset SessionStart = new(2026, 11, 22, 18, 0, 0, TimeSpan.Zero);
+
+    private static HlsSessionPerformanceModel Session(double? buffer, double? speed = 0.8) =>
+        new(
+            "2",
+            "next",
+            true,
+            SessionStart,
+            buffer,
+            new FFmpegTranscodePerformance(
+                42,
+                false,
+                false,
+                SessionStart,
+                null,
+                null,
+                new FFmpegProgressSnapshot(null, speed, null, null, null, null, null, null, null),
+                55,
+                50,
+                FFmpegAccelerationInfo.Unknown with { IsHardwareDecode = true }),
+            []);
+
+    [Test]
+    public void Records_One_Underrun_Until_Buffer_Recovers()
+    {
+        var detector = new UnderrunDetector(TimeSpan.FromSeconds(30));
+        DateTimeOffset t = SessionStart.AddMinutes(5);
+
+        detector.Update(t, [Session(3)]).Started.ShouldBeEmpty();
+
+        (List<UnderrunEvent> started, _) = detector.Update(t.AddSeconds(1), [Session(-0.2)]);
+        started.Count.ShouldBe(1);
+        started[0].MediaItemId.ShouldBe(42);
+        started[0].IsHardwareDecode.ShouldBe(true);
+
+        // dipping and partly recovering stays one underrun
+        detector.Update(t.AddSeconds(2), [Session(-1.5, 0.6)]).Started.ShouldBeEmpty();
+        detector.Update(t.AddSeconds(3), [Session(1)]).Ended.ShouldBeEmpty();
+        detector.Ongoing.Count.ShouldBe(1);
+
+        (_, List<UnderrunEvent> ended) = detector.Update(t.AddSeconds(6), [Session(2.5, 1.2)]);
+        ended.Count.ShouldBe(1);
+        ended[0].Duration.ShouldBe(TimeSpan.FromSeconds(5));
+        ended[0].MinBufferSeconds.ShouldBe(-1.5);
+        ended[0].SlowestSpeed.ShouldBe(0.6);
+        ended[0].EndedBySessionStop.ShouldBeFalse();
+        detector.Ongoing.ShouldBeEmpty();
+    }
+
+    [Test]
+    public void Ignores_Empty_Buffer_While_Session_Starts()
+    {
+        var detector = new UnderrunDetector(TimeSpan.FromSeconds(30));
+
+        detector.Update(SessionStart.AddSeconds(5), [Session(0)]).Started.ShouldBeEmpty();
+        detector.Update(SessionStart.AddSeconds(31), [Session(0)]).Started.Count.ShouldBe(1);
+    }
+
+    [Test]
+    public void Ends_Underrun_When_Session_Stops()
+    {
+        var detector = new UnderrunDetector(TimeSpan.Zero);
+        DateTimeOffset t = SessionStart.AddMinutes(1);
+
+        detector.Update(t, [Session(-1)]);
+        (_, List<UnderrunEvent> ended) = detector.Update(t.AddSeconds(4), []);
+
+        ended.Count.ShouldBe(1);
+        ended[0].EndedBySessionStop.ShouldBeTrue();
+        ended[0].Duration.ShouldBe(TimeSpan.FromSeconds(4));
+    }
+
+    [Test]
+    public void Unknown_Buffer_Neither_Starts_Nor_Ends()
+    {
+        var detector = new UnderrunDetector(TimeSpan.Zero);
+        DateTimeOffset t = SessionStart.AddMinutes(1);
+
+        detector.Update(t, [Session(null)]).Started.ShouldBeEmpty();
+        detector.Update(t.AddSeconds(1), [Session(-1)]);
+        detector.Update(t.AddSeconds(2), [Session(null)]).Ended.ShouldBeEmpty();
+        detector.Ongoing.Count.ShouldBe(1);
+    }
+
+    [Test]
+    public void Log_Persists_Finished_Underruns()
+    {
+        string folder = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString("N"));
+        string path = Path.Combine(folder, "underruns.jsonl");
+        try
+        {
+            var detector = new UnderrunDetector(TimeSpan.Zero);
+            DateTimeOffset t = SessionStart.AddMinutes(1);
+            detector.Update(t, [Session(-1)]);
+            UnderrunEvent finished = detector.Update(t.AddSeconds(3), [Session(5)]).Ended.Single();
+
+            var log = new UnderrunLog(path);
+            log.Add(finished);
+            log.SetOngoing([finished with { ChannelNumber = "7", EndedAt = null }]);
+            log.GetEvents().Select(e => e.ChannelNumber).ShouldBe(["7", "2"]);
+
+            new UnderrunLog(path).GetEvents().ShouldBe([finished]);
+        }
+        finally
+        {
+            if (Directory.Exists(folder))
+            {
+                Directory.Delete(folder, true);
+            }
+        }
+    }
+}
diff --git a/ErsatzTV.Core/FFmpeg/UnderrunDetector.cs b/ErsatzTV.Core/FFmpeg/UnderrunDetector.cs
new file mode 100644
index 00000000..a7b41e7c
--- /dev/null
+++ b/ErsatzTV.Core/FFmpeg/UnderrunDetector.cs
@@ -0,0 +1,102 @@
+namespace ErsatzTV.Core.FFmpeg;
+
+// an underrun is the transcoded output falling behind live, which stalls every client of the channel
+public record UnderrunEvent(
+    string ChannelNumber,
+    string Engine,
+    DateTimeOffset StartedAt,
+    DateTimeOffset? EndedAt,
+    double MinBufferSeconds,
+    double? SlowestSpeed,
+    double? CpuPercent,
+    int? MediaItemId,
+    bool IsWorkingAhead,
+    bool? IsHardwareDecode,
+    bool? IsHardwareEncode,
+    bool EndedBySessionStop)
+{
+    public TimeSpan? Duration => EndedAt - StartedAt;
+}
+
+public sealed class UnderrunDetector(TimeSpan startupGrace)
+{
+    // sessions start with an empty buffer while the first segments are produced
+    public static readonly TimeSpan DefaultStartupGrace = TimeSpan.FromSeconds(30);
+
+    // require some headroom before calling it recovered, so one underrun is not logged as many
+    public const double RecoveredBufferSeconds = 2.0;
+
+    private readonly Dictionary<string, UnderrunEvent> _open = new(StringComparer.Ordinal);
+
+    public List<UnderrunEvent> Ongoing => _open.Values.OrderBy(e => e.StartedAt).ToList();
+
+    public (List<UnderrunEvent> Started, List<UnderrunEvent> Ended) Update(
+        DateTimeOffset now,
+        IReadOnlyCollection<HlsSessionPerformanceModel> sessions)
+    {
+        var started = new List<UnderrunEvent>();
+        var ended = new List<UnderrunEvent>();
+
+        foreach (string channelNumber in _open.Keys.ToList())
+        {
+            if (sessions.All(s => s.ChannelNumber != channelNumber))
+            {
+                ended.Add(_open[channelNumber] with { EndedAt = now, EndedBySessionStop = true });
+                _open.Remove(channelNumber);
+            }
+        }
+
+        foreach (HlsSessionPerformanceModel session in sessions)
+        {
+            if (!session.IsSupported || session.BufferSeconds is not { } buffer || session.ChannelNumber is null)
+            {
+                continue;
+            }
+
+            FFmpegTranscodePerformance current = session.Current;
+            if (_open.TryGetValue(session.ChannelNumber, out UnderrunEvent open))
+            {
+                UnderrunEvent updated = open with
+                {
+                    MinBufferSeconds = Math.Min(open.MinBufferSeconds, buffer),
+                    SlowestSpeed = Min(open.SlowestSpeed, current?.Progress.CurrentSpeed),
+                    CpuPercent = current?.CpuPercent ?? open.CpuPercent,
+                    MediaItemId = current?.MediaItemId ?? open.MediaItemId
+                };
+
+                if (buffer >= RecoveredBufferSeconds)
+                {
+                    ended.Add(updated with { EndedAt = now });
+                    _open.Remove(session.ChannelNumber);
+                }
+                else
+                {
+                    _open[session.ChannelNumber] = updated;
+                }
+            }
+            else if (buffer <= 0 && now - session.StartedAt >= startupGrace)
+            {
+                var underrun = new UnderrunEvent(
+                    session.ChannelNumber,
+                    session.State,
+                    now,
+                    null,
+                    buffer,
+                    current?.Progress.CurrentSpeed,
+                    current?.CpuPercent,
+                    current?.MediaItemId,
+                    current?.IsWorkingAhead ?? false,
+                    current?.Acceleration.IsHardwareDecode,
+                    current?.Acceleration.IsHardwareEncode,
+                    false);
+                _open[session.ChannelNumber] = underrun;
+                started.Add(underrun);
+            }
+        }
+
+        return (started, ended);
+    }
+
+    private static double? Min(double? a, double? b) =>
+        a is { } x && b is { } y ? Math.Min(x, y) : a ?? b;
+}
diff --git a/ErsatzTV.Core/FFmpeg/UnderrunLog.cs b/ErsatzTV.Core/FFmpeg/UnderrunLog.cs
new file mode 100644
index 00000000..d055ec49
--- /dev/null
+++ b/ErsatzTV.Core/FFmpeg/UnderrunLog.cs
@@ -0,0 +1,103 @@
+using System.Text.Json;
+
+namespace ErsatzTV.Core.FFmpeg;
+
+// finished underruns are appended to a json lines file so the history survives restarts
+public sealed class UnderrunLog
+{
+    private const int MaxEvents = 2000;
+    private const long MaxFileBytes = 5 * 1024 * 1024;
+
+    private readonly Lock _sync = new();
+    private readonly string _path;
+    private readonly List<UnderrunEvent> _events = [];
+    private List<UnderrunEvent> _ongoing = [];
+
+    public UnderrunLog(string path)
+    {
+        _path = path;
+        Load();
+    }
+
+    public void Add(UnderrunEvent underrun)
+    {
+        lock (_sync)
+        {
+            _events.Add(underrun);
+            if (_events.Count > MaxEvents)
+            {
+                _events.RemoveRange(0, _events.Count - MaxEvents);
+            }
+
+            try
+            {
+                Directory.CreateDirectory(Path.GetDirectoryName(_path)!);
+                if (File.Exists(_path) && new FileInfo(_path).Length > MaxFileBytes)
+                {
+                    File.Move(_path, _path + ".1", true);
+                }
+
+                File.AppendAllText(_path, JsonSerializer.Serialize(underrun) + Environment.NewLine);
+            }
+            catch (Exception)
+            {
+                // the in-memory log still has it
+            }
+        }
+    }
+
+    public void SetOngoing(List<UnderrunEvent> ongoing)
+    {
+        lock (_sync)
+        {
+            _ongoing = ongoing;
+        }
+    }
+
+    // ongoing underruns first, then finished ones, newest first
+    public List<UnderrunEvent> GetEvents()
+    {
+        lock (_sync)
+        {
+            return _ongoing
+                .OrderByDescending(e => e.StartedAt)
+                .Concat(_events.OrderByDescending(e => e.StartedAt))
+                .ToList();
+        }
+    }
+
+    private void Load()
+    {
+        try
+        {
+            if (!File.Exists(_path))
+            {
+                return;
+            }
+
+            foreach (string line in File.ReadLines(_path))
+            {
+                try
+                {
+                    if (JsonSerializer.Deserialize<UnderrunEvent>(line) is { } underrun)
+                    {
+                        _events.Add(underrun);
+                    }
+                }
+                catch (JsonException)
+                {
+                    // skip partial lines
+                }
+            }
+
+            if (_events.Count > MaxEvents)
+            {
+                _events.RemoveRange(0, _events.Count - MaxEvents);
+            }
+        }
+        catch (Exception)
+        {
+            // start with an empty log
+        }
+    }
+}
