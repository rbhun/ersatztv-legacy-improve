index 00000000..d6296e39
--- /dev/null
+++ b/ErsatzTV/Services/UnderrunMonitorService.cs
@@ -0,0 +1,63 @@
+using ErsatzTV.Core.FFmpeg;
+using ErsatzTV.Core.Interfaces.FFmpeg;
+
+namespace ErsatzTV.Services;
+
+// watches every streaming channel, whether or not the performance page is open
+public class UnderrunMonitorService(
+    IFFmpegSegmenterService segmenterService,
+    UnderrunLog underrunLog,
+    ILogger<UnderrunMonitorService> logger)
+    : BackgroundService
+{
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        var detector = new UnderrunDetector(UnderrunDetector.DefaultStartupGrace);
+
+        try
+        {
+            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
+            while (await timer.WaitForNextTickAsync(stoppingToken))
+            {
+                try
+                {
+                    List<HlsSessionPerformanceModel> sessions = segmenterService.Workers
+                        .ToList()
+                        .Map(w => w.GetPerformance())
+                        .ToList();
+
+                    (List<UnderrunEvent> started, List<UnderrunEvent> ended) =
+                        detector.Update(DateTimeOffset.Now, sessions);
+
+                    foreach (UnderrunEvent underrun in started)
+                    {
+                        logger.LogWarning(
+                            "Underrun on channel {Channel}: transcoding fell behind live (speed {Speed:0.00}x); clients will stall",
+                            underrun.ChannelNumber,
+                            underrun.SlowestSpeed);
+                    }
+
+                    foreach (UnderrunEvent underrun in ended)
+                    {
+                        underrunLog.Add(underrun);
+                        logger.LogWarning(
+                            "Underrun on channel {Channel} ended after {Duration:0.0}s, lowest buffer {Buffer:0.0}s",
+                            underrun.ChannelNumber,
+                            underrun.Duration?.TotalSeconds,
+                            underrun.MinBufferSeconds);
+                    }
+
+                    underrunLog.SetOngoing(detector.Ongoing);
+                }
+                catch (Exception ex)
+                {
+                    logger.LogDebug(ex, "Failed to check channels for underruns");
+                }
+            }
+        }
+        catch (OperationCanceledException)
+        {
+            // do nothing
+        }
+    }
+}
