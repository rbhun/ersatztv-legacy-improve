diff --git a/ErsatzTV.Core.Tests/Extensions/MediaItemExtensionsTests.cs b/ErsatzTV.Core.Tests/Extensions/MediaItemExtensionsTests.cs
new file mode 100644
index 00000000..9bca17a2
--- /dev/null
