# Copy to /opt/ersatztv/local/env on the target and edit.
# This file is NEVER committed. The public repo only ships this example.

ETV_IMAGE=ersatztv:multi-audio

DEPLOY_DIR=/opt/ersatztv-deploy
ETV_DIR=/opt/ersatztv
MEDIA_PATH=/mnt/media
ETV_PORT=8409
TZ=Europe/Budapest
RENDER_NODE=/dev/dri/renderD129

IMAGE_MODE=build
SKIP_UNCHANGED_BUILD=1

# Health Check update agent (host process the container calls).
UPDATE_AGENT_BIND=0.0.0.0
UPDATE_AGENT_PORT=8410
# Shared secret — put a long random string here; compose injects it into the container.
UPDATE_AGENT_TOKEN=change-me
# How the container reaches the host agent.
UPDATE_AGENT_URL=http://host.docker.internal:8410

# Selectable update sources for the Health Check UI.
# id|Label|git-url|branch ; … (semicolon-separated)
# MUST be quoted — the | characters are not shell pipes when quoted.
UPDATE_SOURCES='improvements|Improvements|https://github.com/rbhun/ersatztv-legacy-improve.git|main'
